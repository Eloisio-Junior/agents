{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  // NOTE: the runtime types (and the `Env` interface built from the bindings in
  // wrangler.toml) come from worker-configuration.d.ts, generated by
  // `wrangler types` and committed. It replaces the deprecated
  // @cloudflare/workers-types: the generated types are pinned to this worker's
  // compatibility_date, so they match the APIs the runtime actually exposes.
  // Re-run `bunx wrangler types` from this directory after editing wrangler.toml.
  "include": ["src", "worker-configuration.d.ts"]
}
